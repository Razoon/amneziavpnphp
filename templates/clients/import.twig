{% extends "layout.twig" %}
{% block title %}Import Clients{% endblock %}

{% block content %}
<div class="max-w-5xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-4">Import existing clients</h1>

  {% if message %}
    <div class="mb-4 px-4 py-3 rounded {{ message.type == 'success' ? 'bg-green-50 text-green-700 border border-green-200' : (message.type == 'warning' ? 'bg-yellow-50 text-yellow-800 border border-yellow-200' : 'bg-red-50 text-red-700 border border-red-200') }}">
      <div class="font-semibold">{{ message.text }}</div>
      {% if message.errors and message.errors|length > 0 %}
        <ul class="list-disc pl-5 text-sm mt-2">
          {% for err in message.errors %}<li>{{ err }}</li>{% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endif %}

  {% if error %}
    <div class="mb-4 px-4 py-3 rounded bg-red-50 text-red-700 border border-red-200">{{ error }}</div>
  {% endif %}

  <div class="bg-white rounded shadow p-6 mb-6">
    <form method="GET" action="/clients/import" class="space-y-4">
      <div>
        <label class="block text-sm text-gray-600 mb-1">Server</label>
        <select name="server_id" class="w-full border px-3 py-2 rounded" required>
          <option value="">Select server</option>
          {% for server in servers %}
            <option value="{{ server.id }}" {% if selected_server == server.id %}selected{% endif %}>{{ server.name }} ({{ server.host }})</option>
          {% endfor %}
        </select>
      </div>
      <button type="submit" class="gradient-bg text-white px-4 py-2 rounded">Load peers</button>
    </form>
  </div>

  {% if selected_server %}
  <form method="POST" action="/clients/import" class="bg-white rounded shadow p-6 space-y-4">
    <input type="hidden" name="server_id" value="{{ selected_server }}">
    <div>
      <label class="block text-sm text-gray-600 mb-1">Assign owner</label>
      <select name="user_id" class="w-full border px-3 py-2 rounded" required>
        <option value="">Select user</option>
        {% for user in users %}
          <option value="{{ user.id }}">{{ user.name }} ({{ user.email }})</option>
        {% endfor %}
      </select>
    </div>
    <div class="flex items-center gap-2">
      <input type="checkbox" name="regenerate_configs" id="regenerateConfigs" class="h-4 w-4 text-purple-600">
      <label for="regenerateConfigs" class="text-sm text-gray-700">Generate configs and QR (if private keys are present)</label>
    </div>

    {% if peers|length > 0 %}
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Import</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">IP</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Public Key</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            {% for peer in peers %}
              <tr>
                <td class="px-4 py-2">
                  <input type="checkbox" name="selected_peers[]" value="{{ loop.index0 }}" class="h-4 w-4 text-purple-600" checked>
                  <input type="hidden" name="peer_key[{{ loop.index0 }}]" value="{{ peer.public_key }}">
                  <input type="hidden" name="peer_ip[{{ loop.index0 }}]" value="{{ peer.client_ip }}">
                </td>
                <td class="px-4 py-2">
                  <input type="text" name="peer_name[{{ loop.index0 }}]" value="{{ peer.name ?? '' }}" class="w-full border px-2 py-1 rounded">
                </td>
                <td class="px-4 py-2 text-sm text-gray-700">{{ peer.client_ip }}</td>
                <td class="px-4 py-2 text-xs font-mono break-all">{{ peer.public_key }}</td>
                <td class="px-4 py-2 text-sm">
                  {% if peer.existing %}
                    <span class="px-2 py-1 bg-blue-100 text-blue-800 rounded text-xs">Existing (ID {{ peer.existing.id }})</span>
                  {% else %}
                    <span class="px-2 py-1 bg-green-100 text-green-800 rounded text-xs">New</span>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="text-right">
        <button type="submit" class="gradient-bg text-white px-4 py-2 rounded">Import selected</button>
      </div>
    {% else %}
      <div class="text-gray-500">No peers detected on the server.</div>
    {% endif %}
  </form>
  {% endif %}
</div>
{% endblock %}
